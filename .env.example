# ---------------------------------------------------------------------------
# openclaw-vps configuration. Copy to `.env`, fill in, then `chmod 600 .env`.
# setup.sh installs a 0600 copy at /home/openclaw/.openclaw/.env, which is the
# env file the OpenClaw Gateway daemon reads (docs: Gateway > Secrets & env).
# ---------------------------------------------------------------------------

# --- required ---------------------------------------------------------------

# Free Gemini API key from https://aistudio.google.com/apikey
# OpenClaw accepts GEMINI_API_KEY or GOOGLE_API_KEY for the `google` provider.
GEMINI_API_KEY=

# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# --- strongly recommended ---------------------------------------------------

# Tailscale auth key (https://login.tailscale.com/admin/settings/keys).
# Use a reusable, ephemeral=false, pre-authorized key. Leave empty to skip
# Tailscale and run `sudo tailscale up` by hand later.
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=openclaw-vps

# Your numeric Telegram user ID. When set, setup.sh locks the bot to you with
# dmPolicy=allowlist + allowFrom + commands.ownerAllowFrom, which the docs
# recommend over relying on a past pairing approval for one-owner bots.
# Leave empty to use the default `pairing` flow and run ./pair.sh instead.
TELEGRAM_USER_ID=

# Where the health-check timer sends alerts. Usually the same as
# TELEGRAM_USER_ID. Leave empty to disable Telegram alerting.
TELEGRAM_CHAT_ID=

# --- model ------------------------------------------------------------------

# Model ref for agents.defaults.model.primary. A bare id is prefixed with
# `google/`. NOTE: `gemini-2.5-flash` is NOT in OpenClaw's current Google
# catalog (2.5 survives only as gemini-2.5-pro and the 2.5 *-tts previews).
# Verified flash-tier text ids: gemini-3.8-flash, gemini-3.6-flash.
# Check yours with: openclaw models list --provider google
OPENCLAW_MODEL=gemini-3.8-flash

# --- gateway ----------------------------------------------------------------

# Loopback port for the Gateway. Never opened in UFW. The browser control
# service listens on OPENCLAW_GATEWAY_PORT + 2.
OPENCLAW_GATEWAY_PORT=18789

# Gateway auth token. Leave empty and setup.sh generates one and writes it
# back into this file. Stored as an env SecretRef, not as plaintext in
# openclaw.json.
OPENCLAW_GATEWAY_TOKEN=

# --- host / behaviour toggles ----------------------------------------------

# Runtime user. Created by setup.sh if missing.
OPENCLAW_USER=openclaw

# Browser engine for the agent:
#   chrome     - Google Chrome stable from Google's apt repo (default, amd64).
#                OpenClaw's Linux docs recommend this; `apt install chromium`
#                on Ubuntu installs a snap wrapper whose AppArmor confinement
#                breaks OpenClaw's CDP launch.
#   playwright - Playwright-managed Chromium via `playwright install
#                --with-deps chromium`. Default and only option on arm64.
BROWSER_ENGINE=chrome

# Set to 1 only if you accept being locked out: hardens sshd even when no
# authorized_keys could be found for the runtime user.
FORCE_SSH_HARDENING=0

# Swap file size created when the host has < 4 GB RAM. Empty disables swap.
SWAP_SIZE=2G
